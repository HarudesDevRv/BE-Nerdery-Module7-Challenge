// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

enum Role {
  client
  manager
  delivery_person
}

enum OrderStatus {
  pending
  paid
  processing
  cancelled
  shipped
  delivered
}

enum DiscountType {
  percentage
  fixed
}

model Address {
  addressId  String    @id @default(uuid()) @map("address_id")
  address    String    @default("") @map("address") @db.VarChar(255)
  city       String    @default("") @map("city") @db.VarChar(100)
  country    String    @default("") @map("country") @db.VarChar(100)
  postalCode String?   @map("postal_code") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  user       User?
  store      Store?

  @@map("addresses")
}

model User {
  userId        String          @id @default(uuid()) @map("user_id")
  addressId     String          @unique @map("address_id")
  address       Address         @relation(fields: [addressId], references: [addressId])
  email         String          @unique @map("email") @db.VarChar(255)
  role          Role            @default(client)
  firstName     String          @map("first_name") @db.VarChar(50)
  lastName      String          @map("last_name") @db.VarChar(50)
  password      String          @map("password") @db.VarChar(72)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  passwordReset PasswordReset[]
  productLikes  UserLike[]
  cart          Cart?
  orders        Order[]
  stores        Store[]
  tokens        RefreshToken[]
  products      Product[]

  @@map("users")
}

model RefreshToken {
  refreshToken String   @id @map("refresh_token") @db.VarChar(500)
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [userId])
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expiration_time")
  revoked      Boolean  @default(false)

  @@map("refresh_tokens")
}

model PasswordReset {
  resetToken String   @id @map("reset_token") @db.VarChar(500)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [userId])
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @default(now()) @map("expires_at")

  @@map("password_resets")
}

model Category {
  categoryId  String    @id @default(uuid()) @map("category_id")
  name        String    @unique @db.VarChar(50)
  description String    @db.VarChar(500)
  imageUrl    String    @map("image_url") @db.VarChar(2048)
  isActive    Boolean   @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  product     Product[]

  @@map("categories")
}

model Brand {
  brandId     String    @id @default(uuid()) @map("brand_id")
  name        String    @unique @db.VarChar(100)
  description String    @db.VarChar(500)
  imageUrl    String    @map("image_url") @db.VarChar(2048)
  isActive    Boolean   @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  product     Product[]

  @@map("brands")
}

model Store {
  storeId   String      @id @default(uuid()) @map("store_id")
  addressId String      @unique
  managerId String
  address   Address     @relation(fields: [addressId], references: [addressId])
  manager   User        @relation(fields: [managerId], references: [userId])
  name      String      @unique @db.VarChar(100)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")
  products  Inventory[]

  @@map("stores")
}

model Product {
  productId   String      @id @default(uuid()) @map("product_id")
  categoryId  String      @map("category_id")
  brandId     String      @map("brand_id")
  managerId   String      @map("manager_id")
  category    Category    @relation(fields: [categoryId], references: [categoryId])
  brand       Brand       @relation(fields: [brandId], references: [brandId])
  manager     User        @relation(fields: [managerId], references: [userId])
  name        String      @db.VarChar(100)
  description String      @db.VarChar(1000)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  userLikes   UserLike[]
  inventories Inventory[]
  images      Image[]

  @@unique([name, managerId])
  @@map("products")
}

model Image {
  imageId   String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [productId])
  url       String?   @unique @db.VarChar(2048)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("images")
}

model Inventory {
  inventoryId String         @id @default(uuid())
  storeId     String         @map("store_id")
  productId   String         @map("product_id")
  store       Store          @relation(fields: [storeId], references: [storeId])
  product     Product        @relation(fields: [productId], references: [productId])
  price       Decimal        @db.Decimal(8, 2)
  salePrice   Decimal        @map("sale_price") @db.Decimal(8, 2)
  stock       Int
  isActive    Boolean        @map("is_active")
  deletedAt   DateTime?      @map("deleted_at")
  orders      OrderProduct[]
  carts       CartItem[]

  @@unique([storeId, productId])
  @@map("inventories")
}

model UserLike {
  productId String   @map("product_id")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [userId])
  product   Product  @relation(fields: [productId], references: [productId])
  isActive  Boolean  @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([productId, userId])
  @@map("user_likes")
}

model Cart {
  cartId    String     @id @default(uuid()) @map("cart_id")
  userId    String     @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [userId])
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  products  CartItem[]

  @@map("carts")
}

model CartItem {
  cartId      String    @map("cart_id")
  inventoryId String    @map("inventory_id")
  inventory   Inventory @relation(fields: [inventoryId], references: [inventoryId])
  cart        Cart      @relation(fields: [cartId], references: [cartId])
  amount      Int

  @@id([cartId, inventoryId])
  @@map("cart_items")
}

model Payment {
  paymentId     String    @id @map("payment_id")
  amount        Int
  currency      String    @db.VarChar(3)
  paymentMethod String?   @map("payment_method") @db.VarChar(50)
  status        String    @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  order         Order?

  @@map("payments")
}

model Order {
  orderId       String               @id @default(uuid()) @map("order_id")
  userId        String               @map("user_id")
  paymentId     String?              @unique @map("payment_id")
  user          User                 @relation(fields: [userId], references: [userId])
  payment       Payment?             @relation(fields: [paymentId], references: [paymentId])
  subtotal      Decimal              @map("subtotal") @db.Decimal(10, 2)
  total         Decimal              @map("total") @db.Decimal(10, 2)
  currency      String               @map("currency") @db.VarChar(3)
  status        OrderStatus          @map("status")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  deletedAt     DateTime?            @map("deleted_at")
  products      OrderProduct[]
  discountCodes OrderDiscountCodes[]

  @@map("orders")
}

model OrderStatusChange {
  orderId String      @map("order_id")
  status  OrderStatus @map("status")
  date    DateTime    @default(now()) @map("date")

  @@id([orderId, status])
  @@map("order_status_changes")
}

model OrderProduct {
  orderId     String    @map("order_id")
  inventoryId String    @map("product_id")
  orders      Order     @relation(fields: [orderId], references: [orderId])
  products    Inventory @relation(fields: [inventoryId], references: [inventoryId])
  amount      Int
  price       Decimal   @db.Decimal(8, 2)

  @@id([orderId, inventoryId])
  @@map("order_products")
}

model DiscountCode {
  discountCodeId        String               @id @default(uuid()) @map("discount_code_id")
  code                  String               @unique @map("code")
  discountType          DiscountType         @map("discount_type")
  discountValue         Decimal              @map("discount_value") @db.Decimal(10, 2)
  expirationDate        DateTime             @map("expiration_date")
  usageLimit            Int                  @map("usage_limit")
  minAmount             Int?                 @map("min_amount")
  isActive              Boolean              @default(true) @map("is_active")
  stripeCouponId        String?              @map("stripe_coupon_id")
  stripePromotionCodeId String?              @map("stripe_promotion_code_id")
  orders                OrderDiscountCodes[]

  @@map("discount_codes")
}

model OrderDiscountCodes {
  orderId        String       @map("order_id")
  discountCodeId String       @map("discount_code_id")
  orders         Order        @relation(fields: [orderId], references: [orderId])
  discountCodes  DiscountCode @relation(fields: [discountCodeId], references: [discountCodeId])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([orderId, discountCodeId])
  @@map("order_discount_codes")
}
